[Unit]
Description=BSP Registry Tools MCP server (HTTP transport)
Documentation=https://github.com/Advantech-EECC/bsp-registry-tools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configure via BSP_MCP_* environment variables (see bsp-mcp --help) in
# /etc/default/bsp-mcp, e.g.:
#   BSP_MCP_HOST=0.0.0.0
#   BSP_MCP_PORT=8765
#   BSP_MCP_REGISTRY=/etc/bsp/bsp-registry.yaml
EnvironmentFile=-/etc/default/bsp-mcp
# Run as the dedicated "bsp" system user (created by the package postinst
# and added to the docker group when it exists): kas-container refuses to
# run as root. HOME is set explicitly because systemd < v252 does not set
# it from User=; the registry cache and job state live under ~/.cache/bsp.
User=bsp
Group=bsp
Environment=HOME=/var/lib/bsp
# Builds with a relative build_path land under the working directory;
# StateDirectory makes systemd create /var/lib/bsp-mcp automatically
# (owned by the unit's user).
StateDirectory=bsp-mcp
WorkingDirectory=/var/lib/bsp-mcp
ExecStart=/usr/bin/bsp-mcp --transport http $BSP_MCP_OPTS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
